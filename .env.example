# =====================================================================
# Chép file này thành .env rồi điền giá trị thật.  .env KHÔNG được commit.
#   cp .env.example .env
# =====================================================================

# ---------- PostgreSQL (dùng bởi docker-compose và backend) ----------
POSTGRES_DB=tntt
POSTGRES_USER=tntt
POSTGRES_PASSWORD=doi_mat_khau_nay_di
# 5433 chứ không phải 5432: nhiều máy đã cài sẵn PostgreSQL chiếm cổng 5432.
# Đây là cổng phía MÁY THẬT; bên trong container Postgres vẫn nghe ở 5432.
POSTGRES_PORT=5433

# ---------- pgAdmin (chỉ chạy ở máy dev) ----------
PGADMIN_EMAIL=admin@xudoan.local
PGADMIN_PASSWORD=doi_mat_khau_nay_di
PGADMIN_PORT=5050

# ---------- Backend ----------
# LƯU Ý: Spring Boot KHÔNG tự đọc file .env này (chỉ docker-compose đọc).
# Khi chạy backend bằng `mvn spring-boot:run`, giá trị dùng là default trong
# application.yml — đã để khớp với các giá trị dev bên dưới. Xem README mục 4.
DB_HOST=localhost
DB_PORT=5433
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# URL frontend được phép gọi API (CORS). Nhiều giá trị cách nhau bởi dấu phẩy.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- JWT (Sprint 1 mới dùng, khai báo sẵn để khỏi quên) ----------
# Sinh khoá bằng:  openssl rand -base64 64
APP_JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_it_nhat_64_ky_tu_khong_duoc_de_gia_tri_nay
APP_JWT_ACCESS_TTL_MINUTES=30
APP_JWT_REFRESH_TTL_DAYS=7
